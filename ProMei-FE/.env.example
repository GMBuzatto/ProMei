# URL base da API, com o prefixo de versão. Obrigatória.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Timeout de cada requisição HTTP, em ms.
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# TanStack Query: por quanto tempo (ms) um dado é considerado fresco.
NEXT_PUBLIC_QUERY_STALE_TIME_MS=30000

# TanStack Query: retentativas de query em falha transitória (4xx de negócio nunca repete).
NEXT_PUBLIC_QUERY_RETRY=1
