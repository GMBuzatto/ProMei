# App
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Banco
# Porta 55432: o docker-compose expoe o Postgres nessa porta para nao disputar
# com instalacoes nativas do Postgres, que costumam ocupar 5432 e 5433.
DATABASE_URL=postgresql://promei:promei@127.0.0.1:55432/promei?schema=public
# Tamanho do pool de conexoes do driver pg. Default do pg (10) e apertado para
# requisicoes que seguram conexao por uma transacao inteira (venda, N itens) —
# concorrencia real esbarra em "timeout exceeded when trying to connect" antes
# de qualquer lock do Postgres entrar em jogo.
DATABASE_POOL_MAX=20

# Auth (mínimo 16 caracteres — troque em qualquer ambiente real)
# TTLs em segundos (900 = 15min, 604800 = 7d, 1296000 = 15d)
JWT_ACCESS_SECRET=dev-access-secret-troque-me
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=dev-refresh-secret-troque-me
JWT_REFRESH_TTL=604800
JWT_REFRESH_TTL_REMEMBER_ME=1296000

# Bloqueio de conta após tentativas de login falhas (RF-03)
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MAX_DURATION_MS=3600000
AUTH_LOCKOUT_DURATION_MS=900000

# Rate limit estrito em /auth/* (docs/09-seguranca.md), mais restritivo que o global
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_TTL_MS=60000

# Rate limit global por IP (docs/09-seguranca.md)
RATE_LIMIT_MAX=100
RATE_LIMIT_TTL_MS=60000

# Timeout dos checks de /health/ready (docs/13-observabilidade.md)
HEALTH_CHECK_TIMEOUT_MS=3000

# Paginação padrão de listagens (docs/08-padroes-de-desenvolvimento.md)
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# Geração automática de SKU do item quando não informado (RN-25)
# Formato: <prefixo>-<sequencial zero-padded>, ex.: ITM-000001
ITEM_SKU_PREFIX=ITM
ITEM_SKU_SEQUENCE_PADDING=6
# Tentativas em caso de colisão do sequencial sob concorrência (RN-20)
ITEM_SKU_MAX_ATTEMPTS=5

# Movimentação de estoque (RF-32, RN-21)
# Espera máxima pelo lock da linha do item (SELECT ... FOR UPDATE)
INVENTORY_LOCK_TIMEOUT_MS=5000
# Teto da transação inteira — mantenha MAIOR que INVENTORY_LOCK_TIMEOUT_MS
INVENTORY_TRANSACTION_TIMEOUT_MS=10000
# Quantidade máxima aceita por movimentação (em módulo)
INVENTORY_MAX_MOVEMENT_QUANTITY=1000000

# Comprovante de saída (RF-33, RN-24)
# Disco local no MVP; em produção aponte para um volume persistente
RECEIPT_STORAGE_DIR=./storage/receipts
# Dígitos do número sequencial impresso no comprovante (000123 com padding 6)
RECEIPT_NUMBER_PADDING=6
# Tentativas de geração do PDF antes de o comprovante ficar pendente
RECEIPT_PDF_MAX_ATTEMPTS=3
# Base do backoff exponencial entre tentativas (1s, 2s, 4s...)
RECEIPT_PDF_RETRY_DELAY_MS=1000

# ─────────────────────────────────────────────────────────────────────────────
# Fase 2 — Cliente + Compras (docs/17 a 32)
# ─────────────────────────────────────────────────────────────────────────────

# Período financeiro da empresa (docs/20). Estes sao os PADROES de empresa nova;
# cada empresa guarda os seus em company_finance_settings.
# Dia do fechamento (1..31). Dia maior que o mes satura no ultimo dia (31 em
# fevereiro = 28, ou 29 em bissexto).
FINANCE_DEFAULT_CLOSING_DAY=1
# Fuso usado no CORTE do periodo. O banco guarda tudo em UTC; so a fronteira do
# periodo e calculada no fuso local — sem isso, uma venda das 21h em Sao Paulo
# cairia no periodo seguinte.
FINANCE_DEFAULT_TIMEZONE=America/Sao_Paulo
# Limite de credito de cliente novo. Zero de proposito: ninguem compra fiado ate
# alguem decidir que pode (docs/18).
FINANCE_DEFAULT_CREDIT_LIMIT=0
# Teto aceito em PATCH /customers/:id/credit-limit — barra erro de digitacao
# virando limite de sete digitos.
FINANCE_MAX_CREDIT_LIMIT=1000000
# Prazo padrao quando a venda a prazo nao informa vencimento (docs/19).
FINANCE_DEFAULT_DUE_DAYS=30
# Dias de atraso para o cliente ser considerado INADIMPLENTE (docs/21).
FINANCE_DELINQUENCY_DAYS=30

# Job diario que materializa vendas EM_ATRASO (docs/21).
# CONVENIENCIA, nao correcao: nenhuma decisao de credito depende dele ter rodado
# (RN-67) — a validacao compara due_date < hoje na hora.
FINANCE_OVERDUE_JOB_CRON=0 3 * * *
FINANCE_OVERDUE_JOB_ENABLED=true

# Venda (docs/19). Mesma logica de INVENTORY_*: espera pelo lock e teto da
# transacao, com o teto MAIOR que o lock — senao o Prisma aborta antes de o
# Postgres devolver 55P03 e o motivo real da falha some.
SALES_LOCK_TIMEOUT_MS=5000
SALES_TRANSACTION_TIMEOUT_MS=15000
# Teto de itens por venda: venda longa segura os locks das linhas dos itens por
# mais tempo e atrasa vendas concorrentes dos mesmos produtos.
SALES_MAX_ITEMS_PER_SALE=100
# Digitos do numero sequencial da venda (000123 com padding 6) — separado de
# RECEIPT_NUMBER_PADDING porque sao sequencias e namespaces de lock distintos
# (docs/19: "o numero da venda e o que o operador fala no telefone").
SALES_NUMBER_PADDING=6

# Recebimento (docs/22). Mesma logica de SALES_*/INVENTORY_*: teto MAIOR
# que o lock, senao o Prisma aborta antes de o Postgres devolver 55P03.
PAYMENTS_LOCK_TIMEOUT_MS=5000
PAYMENTS_TRANSACTION_TIMEOUT_MS=15000

# Senha administrativa de liberacao de venda (docs/24).
# Rate limit por USUARIO; lockout progressivo por EMPRESA. Os dois existem
# porque a senha e compartilhada: um operador errando nao pode travar o balcao
# inteiro na primeira tentativa.
SALE_AUTH_RATE_LIMIT_MAX=5
SALE_AUTH_RATE_LIMIT_TTL_MS=60000
SALE_AUTH_MAX_ATTEMPTS=5
SALE_AUTH_LOCKOUT_DURATION_MS=900000

# Limite de clientes por plano quando o plano nao define o seu (docs/27, RN-14).
PLAN_DEFAULT_MAX_CUSTOMERS=100

# Observabilidade
LOG_LEVEL=info
SENTRY_DSN=
# Versao reportada ao Sentry; no deploy, use o SHA do commit.
SENTRY_RELEASE=
# Ambiente reportado ao Sentry. Existe separado do NODE_ENV porque NODE_ENV nao
# pode valer "staging". E este campo que separa os alertas de staging dos de
# producao (docs/13). Vazio = usa o NODE_ENV.
SENTRY_ENVIRONMENT=
# Amostragem de transacoes (0..1). Em 0 nao ha tracing e, sem tracing, nao existe
# p95 — logo o alerta de latencia fica sem sinal. Staging: 1. Producao: 0.1.
SENTRY_TRACES_SAMPLE_RATE=0
# Espera maxima pelo envio dos eventos pendentes no shutdown
SENTRY_FLUSH_TIMEOUT_MS=2000

# Injecao de falha — ensaio dos alertas em staging (docs/13, docs/15)
# NUNCA ligar em producao: o boot falha se tentar.
FAULT_INJECTION_ENABLED=false
# Obrigatorio (min. 16 caracteres) quando FAULT_INJECTION_ENABLED=true
FAULT_INJECTION_TOKEN=
# Teto do atraso aceito pela rota de latencia
FAULT_INJECTION_MAX_DELAY_MS=5000
